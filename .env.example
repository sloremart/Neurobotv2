# === Ambiente ===
# testing = canal de pruebas (.env.testing), production = canal real (default)
APP_ENV=production

# === Aplicación ===
PORT=8080
TZ=America/Bogota
LOG_LEVEL=info
LOG_DIR=/app/logs
# Traza de flujos de negocio (docs/OBSERVABILIDAD.md): off|error|outcome|milestone|full
FLOW_TRACE_LEVEL=milestone

# === Base de Datos Local (Docker MySQL) ===
DB_HOST=db
DB_PORT=3306
DB_DATABASE=neuro_bot
DB_USER=botuser
DB_PASSWORD=botpass
DB_ROOT_PASSWORD=secret

# === Base de Datos Externa (Centro Médico — SIESA / SQL Server) ===
EXTERNAL_DB_HOST=host.docker.internal
EXTERNAL_DB_PORT=1433
EXTERNAL_DB_DATABASE=ZeusSalud_Neuro
EXTERNAL_DB_USER=
EXTERNAL_DB_PASSWORD=

# === Selección de implementación de BD externa (R-ARQ-01) ===
# Único driver soportado: "siesa" (el legacy "datosipsndx"/Antares fue eliminado).
EXTERNAL_DB_DRIVER=siesa

# === Bird API (WhatsApp) ===
BIRD_API_KEY_WA=
BIRD_ACCESS_KEY_ID=
BIRD_WEBHOOK_SECRET=
# Opcional: claves diferentes por tipo de webhook (si no se definen, usan BIRD_WEBHOOK_SECRET)
BIRD_WEBHOOK_SECRET_OUTBOUND=
BIRD_WEBHOOK_SECRET_CONVERSATIONS=
BIRD_WEBHOOK_SECRET_VOICE=
BIRD_WORKSPACE_ID=b41653d6-85ab-462b-9fa9-8f95cab7f35b

# === Bird Canal WhatsApp (producción: +57 300 9139842) ===
# Para pruebas (+57 8 2795066): usar APP_ENV=testing → .env.testing
BIRD_CHANNEL_ID=61a8f3cc-ba98-5181-899f-39e66653eeda
BIRD_API_URL=https://api.bird.com/workspaces/b41653d6-85ab-462b-9fa9-8f95cab7f35b/channels/61a8f3cc-ba98-5181-899f-39e66653eeda

# === Bird Templates (producción V2) ===
BIRD_CHANNEL_ID_TEMPLATES=61a8f3cc-ba98-5181-899f-39e66653eeda
# Confirmación Diaria
BIRD_TEMPLATE_CONFIRM_PROJECT_ID=6293c3d9-ad2e-4976-8463-4350529ce259
BIRD_TEMPLATE_CONFIRM_VERSION_ID=ab930a42-b612-4024-9e72-d3cb53cd7f77
BIRD_TEMPLATE_CONFIRM_LOCALE=es-CO
# Reprogramación Admin
BIRD_TEMPLATE_RESCHEDULE_PROJECT_ID=cda923b7-280b-4ef3-9c11-6cbe9dc2921f
BIRD_TEMPLATE_RESCHEDULE_VERSION_ID=8ec06485-7ebf-417a-a1f2-1f4c5ba83ac1
BIRD_TEMPLATE_RESCHEDULE_LOCALE=es-CO
# Lista de Espera
BIRD_TEMPLATE_WAITING_LIST_PROJECT_ID=4b5e4fdc-f67d-4c40-bb3c-9cb35b06afe4
BIRD_TEMPLATE_WAITING_LIST_VERSION_ID=ce4a66cc-7e40-46e4-8cfd-d0ab453fed11
BIRD_TEMPLATE_WAITING_LIST_LOCALE=es-CO
# Cancelación Admin
BIRD_TEMPLATE_CANCELLATION_PROJECT_ID=112e0b94-67ac-4930-a058-97f1d83c97b7
BIRD_TEMPLATE_CANCELLATION_VERSION_ID=194f41a9-7203-4726-84c9-3836f6bd73eb
BIRD_TEMPLATE_CANCELLATION_LOCALE=es-CO

# === Enrutamiento por especialidad ===
# true = asigna a Grupo A/B según servicio; false = todo al Call Center
TEAM_ROUTING_ENABLED=true

# === Bird Equipos por Servicio ===
# Grupo A: Ecografías, Rayos X, Resonancia, TAC (3 agentes)
BIRD_TEAM_GRUPO_A=75346eb4-15ed-4b61-aa98-6e74c2ddf6cb
# Grupo B: Neurología, Fisiatría, Estudios del sueño (2 agentes)
BIRD_TEAM_GRUPO_B=c25b8a25-4b96-4388-b6cb-741b6b452eb1
# Call Center: Fallback general (5 agentes)
BIRD_TEAM_FALLBACK=8db88508-a013-4c8a-a229-12a77fe1b244
# Agente fallback: si asignación a equipo falla, asignar directo a líder Call Center
BIRD_AGENT_FALLBACK=92cfad53-0442-48b7-92f4-fe660b11fd5f

# === Bird Voice (IVR) ===
BIRD_API_KEY_VOICE=
BIRD_VOICE_CHANNEL_ID=
BIRD_VOICE_NUMBER=
BIRD_VOICE_FLOW_ID=07ff3d7b-7fd9-4da5-bfe0-e059e9e06ea1
# URL pública del servidor (para webhooks Bird Voice; ngrok la genera automáticamente)
#SERVER_PUBLIC_URL=

# === OpenAI (OCR de órdenes médicas) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === Sesiones ===
SESSION_TIMEOUT_MINUTES=120

# === Inactividad (minutos sin respuesta del paciente) ===
# Recordatorio único: minutos de inactividad antes de enviar aviso
INACTIVITY_REMINDER_MIN=5
# Cierre silencioso: minutos de inactividad antes de cerrar (sin mensaje)
INACTIVITY_CLOSE_MIN=15

# === Reintentos ===
# Intentos inválidos antes de mostrar menú de fallback (default: 4)
MAX_RETRIES=4

# === Limites mensuales CUPS ===
# Habilita limites mensuales por grupo de procedimientos (solo SAN01)
CUPS_GROUP_LIMITS_ENABLED=true

# === Escalación de Confirmación ===
# Habilita follow-ups WA + llamada IVR cuando el paciente no confirma (default: false)
# false = solo se envía el recordatorio inicial (comportamiento del proyecto anterior)
# true  = envía follow-up 1, follow-up 2 y llamada IVR si no hay respuesta
CONFIRMATION_FOLLOWUP_ENABLED=false
# Follow-up 1: horas después del template WA (default: 3 → 10:00)
CONFIRMATION_FOLLOWUP_1_HOURS=3
# Follow-up 2: horas después del follow-up 1 (default: 3 → 13:00)
CONFIRMATION_FOLLOWUP_2_HOURS=3
# Escalación a agente: minutos después de IVR (default: 30)
CONFIRMATION_POST_IVR_MINUTES=30

# === Whitelist de teléfonos (solo testing) ===
# Vacío = todos permitidos (producción). En testing, lista separada por comas.
TESTING_WHITELIST_PHONES=

# === Centro Médico ===
CENTER_KEY=datosipsndx
CENTER_NAME=Neuro Electrodiagnóstico del Llano
BOT_NAME=Samuel
RESULTS_URL=
RESULTS_VIDEO_URL=

# === Seguridad ===
INTERNAL_API_KEY=

# === Ngrok ===
NGROK_AUTHTOKEN=
# Para pruebas: usar APP_ENV=testing → .env.testing
NGROK_HOSTNAME=app.colibrixa.com

# === Docker Health Watcher (alertas Telegram) ===
TG_BOT_TOKEN=
TG_CHAT_IDS=

# === Bot Error Alerts (Telegram) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
